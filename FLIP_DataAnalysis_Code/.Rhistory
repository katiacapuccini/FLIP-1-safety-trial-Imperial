LactinV_BactLoad_boxplot <- ggplot(FLIP_Data, aes(x = Timepoint, y = log10(`LactinV_16S_CopyNo/mL`/`Total_Bacterial_Load_16SCopyNo/ml`))) +
geom_boxplot(outlier.shape = NA, col='steelblue4', alpha = 0.6, show.legend = FALSE,  linewidth = 0.5) +
geom_jitter(aes(col = CST), size = 2) +
scale_color_manual(values = CST_colours) +
labs(y = "log10(Lactin-V/Bacterial Load)") + theme_minimal() +
theme(axis.title = element_text(size = 16, face = "bold"),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14, face = "bold"),
legend.text = element_text(size = 12),
strip.text = element_text(size = 14, face = "bold"),
plot.background = element_rect(fill = "white", colour='white'))
