BactLoad_boxplot <- ggplot(FLIP_Data, aes(x = Timepoint, y = log10(`Total_Bacterial_Load_16SCopyNo/ml`))) +
geom_boxplot(outlier.shape = NA, aes(fill=Responder), alpha = 0.6, show.legend = FALSE,  linewidth = 0.5) +
geom_jitter(aes(col = CST), size = 2) +
scale_colour_manual(values = cst_colors, name='b') +
scale_fill_manual(values = responder_colour) +
stat_compare_means(comparisons = list(c("Responder", "Non-responder")),
method = "wilcox.test", label = "p.signif", hide.ns = FALSE) +
labs(y = "log10(Bacterial 16S copies per ml)") + theme_minimal() +
theme(axis.title = element_text(size = 16, face = "bold"),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14, face = "bold"),
legend.text = element_text(size = 12),
strip.text = element_text(size = 14, face = "bold"),
plot.background = element_rect(fill = "white", colour='white'))
stat_test_bactLoad_resp <- FLIP_Data %>%
mutate(log_bacterial_load = log10(`Total_Bacterial_Load_16SCopyNo/ml`)) %>%
group_by(Timepoint) %>%
wilcox_test(log_bacterial_load ~ Responder) %>%
adjust_pvalue(method = "bonferroni") %>%
add_significance("p.adj") %>%
add_xy_position(x = "Timepoint", dodge = 0.8)
bactLoadResp_boxplot <- ggplot(FLIP_Data, aes(x = Timepoint, y = log10(`Total_Bacterial_Load_16SCopyNo/ml`))) +
geom_boxplot(outlier.shape = NA, aes(fill = Responder),
alpha = 0.6, linewidth = 0.5, position = position_dodge(0.8)) +
geom_point(aes(col = CST, group = Responder),
size = 2, position = position_jitterdodge(jitter.width = 0.2, dodge.width = 0.8)) +
scale_colour_manual(values = cst_colors, name = 'CST') +
scale_fill_manual(values = responder_colour, name = 'Responder') +
stat_pvalue_manual(stat_test_bactLoad_resp, label = "p.adj.signif",
tip.length = 0.01, hide.ns = FALSE, step.increase = 0.05) +
labs(y = "log10(Bacterial 16S copies per ml)") +
theme_minimal() +
theme(axis.title = element_text(size = 16, face = "bold"),
axis.text = element_text(size = 14),
legend.title = element_text(size = 14, face = "bold"),
legend.text = element_text(size = 12),
strip.text = element_text(size = 14, face = "bold"),
plot.background = element_rect(fill = "white", colour='white'))
ggplot(FLIP_Data, aes(x = Timepoint, y = log10(`Total_Bacterial_Load_16SCopyNo/ml`))) +
geom_boxplot(outlier.shape = NA, aes(fill=Responder), alpha = 0.6, show.legend = FALSE,  linewidth = 0.5) +
geom_jitter(aes(col = CST), size = 2) +
scale_colour_manual(values = cst_colors, name='b') +
stat_compare_means(comparisons = list(c("Responder", "Non-responder")),
method = "wilcox.test", label = "p.signif", hide.ns = FALSE) +
labs(y = "log10(Bacterial 16S copies per ml)") +
scale_fill_manual(values = responder_colour,
labels = c("Responder" = "Colonizer", "Non-responder" = "Non-colonizer"),
name = "LACTIN-V colonization") +
theme_minimal() +
theme(axis.title = element_text(size = 16, face = "bold"),
